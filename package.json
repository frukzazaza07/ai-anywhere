{
  "name": "codex-discord-ts",
  "version": "1.0.0-beta.1",
  "description": "Self-hosted Discord bot for trusted users of local AI coding CLIs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "models": "node --import tsx src/models-cli.ts",
    "doctor": "node --import tsx src/doctor-cli.ts",
    "release:check": "node scripts/release-check.mjs",
    "register": "node --import tsx src/register.ts",
    "dev": "node --import tsx src/bot.ts",
    "build": "tsc",
    "start": "tsc && node dist/bot.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "files": [
    "src/", "test/", "scripts/", "docs/", "tasks/", "*.md", "LICENSE",
    "tsconfig.json", ".env.example", "ai.config.example.json"
  ],
  "dependencies": {
    "@openai/codex": "0.162.1",
    "discord.js": "14.27.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
