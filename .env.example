DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_GUILD_ID=replace_with_server_id
ALLOWED_USER_IDS=replace_with_your_discord_user_id
# Optional admins must also be allowed users. Blank disables /ai-admin.
ADMIN_USER_IDS=

# Forward slashes work on Windows. Choose a Git repository outside this bot folder.
CODEX_WORKDIR=C:/projects/my-app
CODEX_SANDBOX=read-only
# 0 disables the task deadline (default). Set positive seconds for an optional deadline.
CODEX_TIMEOUT_SECONDS=0

# Optional CLI providers. Codex-only remains the default.
AI_PROVIDERS=codex
AI_DEFAULT_PROVIDER=codex
# Optional operator-configured models (blank uses each CLI default).
CODEX_MODEL=
CLAUDE_MODEL=
GEMINI_MODEL=
# Native Claude executable; blank uses claude on PATH.
CLAUDE_EXECUTABLE=
# Required only when gemini is enabled: absolute JavaScript CLI entry point.
GEMINI_CLI_SCRIPT=

# Legacy runtime settings below are used only when ai.config.json is absent.
# Named projects (existing folders). Discord uses runtime autocomplete.
# AI_PROJECTS='{"web":"D:/projects/my-web","api":"E:/work/my-api"}'
AI_PROJECTS=
# Blank: use default alias when present, otherwise the first configured name.
AI_DEFAULT_PROJECT=
# Optional single-folder setting; takes precedence over CODEX_WORKDIR.
AI_WORKDIR=
